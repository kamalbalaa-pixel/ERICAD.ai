<UserControl x:Class="Frontend.Controls.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Chat Messages Area -->
        <Border Grid.Row="0" Background="#15FFFFFF" CornerRadius="6">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="8" MaxHeight="400">
                <ItemsControl x:Name="ChatMessages" Background="Transparent">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" Padding="10,8" CornerRadius="8"
                                    Background="{Binding Background}" 
                                    HorizontalAlignment="{Binding Alignment}">
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" 
                                           TextWrapping="Wrap" FontSize="12" MaxWidth="280"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        
        <!-- Chat Input Area -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Background="#222222" CornerRadius="6" Margin="0,0,4,0">
                <TextBox x:Name="ChatInput" 
                         Background="Transparent" 
                         Foreground="White" 
                         BorderThickness="0"
                         Padding="10,8"
                         FontSize="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalScrollBarVisibility="Auto"
                         MaxHeight="80"
                         IsEnabled="False"
                         KeyDown="ChatInput_KeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="CaretBrush" Value="#FF6B35"/>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>
            
            <Button x:Name="SendButton" Grid.Column="1" Content="➤" Width="40" Height="36"
                    Background="#FF6B35" Foreground="White" FontSize="14" BorderThickness="0"
                    Cursor="Hand" IsEnabled="False" Click="SendButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E55A2B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#444444"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>









