<UserControl x:Class="Frontend.Controls.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Chat Messages Area -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="4" BorderBrush="#3C3C3C" BorderThickness="1">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="8" MaxHeight="400">
                <ItemsControl x:Name="ChatMessages" Background="Transparent">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" Padding="10,8" CornerRadius="4"
                                    Background="{Binding Background}" 
                                    HorizontalAlignment="{Binding Alignment}">
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" 
                                           TextWrapping="Wrap" FontSize="13" MaxWidth="280"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        
        <!-- Chat Input Area -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Background="#3C3C3C" CornerRadius="4" BorderBrush="#3C3C3C" BorderThickness="1" Margin="0,0,6,0">
                <TextBox x:Name="ChatInput" 
                         Background="Transparent" 
                         Foreground="#CCCCCC" 
                         BorderThickness="0"
                         Padding="8,6"
                         FontSize="13"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalScrollBarVisibility="Auto"
                         MaxHeight="80"
                         IsEnabled="False"
                         KeyDown="ChatInput_KeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="CaretBrush" Value="#007ACC"/>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>
            
            <Button x:Name="SendButton" Grid.Column="1" Width="28" Height="28"
                    Background="Transparent" Foreground="#858585" BorderThickness="0"
                    Cursor="Hand" IsEnabled="False" Click="SendButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                            <Path Data="M12,19 L12,5 M5,12 L12,5 L19,12" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3C3C3C"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4A4A4D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>









